{
  "name": "clock-out-form-reminder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reminds Connecteam staff who clock out without submitting the Compliance Form, then escalates",
  "scripts": {
    "test": "vitest run --project node --project worker --project relay",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p relay/tsconfig.json",
    "deploy": "tsx scripts/deploy-config.ts --check-live && wrangler deploy --config wrangler.deploy.json",
    "deploy:config": "tsx scripts/deploy-config.ts",
    "db:migrate": "tsx scripts/deploy-config.ts --check-live && wrangler d1 migrations apply clock-out-form-reminder --remote --config wrangler.deploy.json",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc",
    "relay:secret": "wrangler secret put --config relay/wrangler.jsonc",
    "relay:teardown": "wrangler delete --config relay/wrangler.jsonc",
    "setup": "bash scripts/setup-wizard.sh",
    "check-api-key": "tsx scripts/check-api-key.ts",
    "wizard-helper": "tsx scripts/wizard-helper.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
