# Copy to `.dev.vars` (git-ignored) and fill in. Used by:
#  - `wrangler dev` (local Worker run)
#  - the live integration tests (test/*.integration.test.ts), which self-skip
#    if the values they need are absent.
# Never copy the research key from ~/IDP/.research.env in here.

# --- Cloudflare ---
# This Deployment's D1 database id (`npx wrangler d1 list`).
D1_DATABASE_ID=

# --- Connecteam (secrets) ---
CT_API_KEY=
CT_WEBHOOK_SECRET=

# --- Connecteam (settings) ---
COMPLIANCE_FORM_ID=
CT_PUBLISHER_ID=
WHERE_TO_FIND=

# --- Timing ---
GRACE_PERIOD_MINUTES=30
ESCALATION_DELAY_MINUTES=240
TIME_ZONE=
